# Copy this file to .env for local development. Never commit the filled .env.
# Use a least-privilege database account and store production values in your
# deployment secret manager or systemd EnvironmentFile.
DATABASE_URL=postgresql://rhythmx_user:change-me@localhost:5432/rhythmx

# Optional chat-generation ceilings. The application uses these values when
# present and falls back to the same defaults if they are omitted.
CHAT_MAX_OUTPUT_TOKENS=300
CHAT_MAX_THINKING_TOKENS=512
